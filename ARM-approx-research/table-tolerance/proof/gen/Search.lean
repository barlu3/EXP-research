import FrecpeLogf.Table

/-!
Finds each cell's largest provable drift, each way, by bisection on the same
`downOK` and `upOK` that `Main.lean` checks in the kernel, and writes
`FrecpeLogf/Cells.lean` and `gen/eps_star.csv`. Run from `proof/lean`:

    lake env lean --run ../gen/Search.lean
-/

open FrecpeLogf

/-- The largest passing `e` in `[lo, hi)`, given `lo` passes and `hi` does not. -/
partial def bisect (ok : ℕ → Bool) (lo hi : ℕ) : ℕ :=
  if hi - lo ≤ 1 then lo else
    let mid := (lo + hi) / 2
    if ok mid then bisect ok mid hi else bisect ok lo mid

/-- Drifts beyond `2^-4` take `r` out of the kernel's range. -/
def eMax : ℕ := 2 ^ 18

def main : IO Unit := do
  let mut lean := "import FrecpeLogf.Table\n\n/-!\nGenerated by `gen/Search.lean`: " ++
    "each cell's proven drift, down and up,\nin units of `2^-22`. `Main.lean` checks " ++
    "every entry in the kernel, so nothing\nhere is trusted.\n-/\n\nnamespace FrecpeLogf\n\n" ++
    "def epsTable : List (ℕ × ℕ) :=\n  ["
  let mut csv := "cell,base_over_512,eps_down_units,eps_up_units\n"
  for i in [0:256] do
    let d := bisect (downOK i) 0 eMax
    let u := bisect (upOK i) 0 eMax
    lean := lean ++ (if i == 0 then "" else if i % 8 == 0 then ",\n   " else ", ") ++ s!"({d}, {u})"
    csv := csv ++ s!"{i},{(base i * 512).num},{d},{u}\n"
    IO.eprintln s!"cell {i}: down {d}, up {u} (units of 2^-22)"
  lean := lean ++ "]\n\nend FrecpeLogf\n"
  IO.FS.writeFile "FrecpeLogf/Cells.lean" lean
  IO.FS.writeFile "../gen/eps_star.csv" csv
